{
  "_comment": "Synthetic, Sysmon-shaped sample events for rule validation. 'expect' is whether the rule SHOULD match. Field names follow the Sigma Windows taxonomy (process_creation / registry_set). These are hand-written test cases, not captured telemetry.",

  "01a_alwaysinstallelevated_registry.yml": [
    {"name": "HKLM policy set to 1", "expect": true,
     "fields": {"EventType": "SetValue", "Image": "C:\\Windows\\regedit.exe",
                "TargetObject": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer\\AlwaysInstallElevated",
                "Details": "DWORD (0x00000001)"}},
    {"name": "HKCU (per-user hive) policy set to 1", "expect": true,
     "fields": {"EventType": "SetValue", "Image": "C:\\Windows\\System32\\reg.exe",
                "TargetObject": "HKU\\S-1-5-21-1111111111-2222222222-3333333333-1001\\Software\\Policies\\Microsoft\\Windows\\Installer\\AlwaysInstallElevated",
                "Details": "DWORD (0x00000001)"}},
    {"name": "BENIGN: policy set back to 0 (remediation)", "expect": false,
     "fields": {"EventType": "SetValue", "Image": "C:\\Windows\\System32\\reg.exe",
                "TargetObject": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer\\AlwaysInstallElevated",
                "Details": "DWORD (0x00000000)"}},
    {"name": "BENIGN: a different Installer policy value set to 1", "expect": false,
     "fields": {"EventType": "SetValue", "Image": "C:\\Windows\\System32\\reg.exe",
                "TargetObject": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\Installer\\DisableMSI",
                "Details": "DWORD (0x00000001)"}},
    {"name": "BENIGN: similarly named value elsewhere", "expect": false,
     "fields": {"EventType": "SetValue", "Image": "C:\\Program Files\\App\\app.exe",
                "TargetObject": "HKLM\\SOFTWARE\\Vendor\\App\\AlwaysInstallElevatedBackup",
                "Details": "DWORD (0x00000001)"}}
  ],

  "03a_sam_hive_dump_reg.yml": [
    {"name": "reg save of SAM (the lab command)", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "C:\\Windows\\System32\\reg.exe save hklm\\sam C:\\temp\\sam.hiv"}},
    {"name": "reg save of SYSTEM, short command, upper case", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "REG SAVE HKLM\\SYSTEM C:\\temp\\system.hiv /y"}},
    {"name": "reg save using the long HKEY_LOCAL_MACHINE spelling", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "reg save HKEY_LOCAL_MACHINE\\SECURITY C:\\temp\\sec.hiv"}},
    {"name": "quoted reg.exe path and quoted hive", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "\"C:\\Windows\\System32\\reg.exe\" save \"HKLM\\SAM\" C:\\temp\\s.hiv"}},
    {"name": "BENIGN: reg query of SAM with a value named 'save'", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "reg query HKLM\\SAM /v save /s"}},
    {"name": "BENIGN: reg save of a non-credential hive", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "reg save HKLM\\SOFTWARE C:\\backup\\software.hiv"}},
    {"name": "BENIGN: reg export of a software key", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\reg.exe",
                "CommandLine": "reg export HKLM\\SOFTWARE\\Vendor C:\\backup\\vendor.reg"}},
    {"name": "BENIGN: a different program mentioning hklm\\sam", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\notepad.exe",
                "CommandLine": "notepad.exe C:\\notes\\reg save hklm\\sam notes.txt"}}
  ],

  "04a_runas_savecred.yml": [
    {"name": "runas /savecred to an admin account (the lab command)", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\runas.exe",
                "CommandLine": "runas /savecred /user:WIN-LAB\\labadmin \"cmd.exe /c whoami\""}},
    {"name": "option in mixed case, after /user", "expect": true,
     "fields": {"Image": "C:\\Windows\\System32\\runas.exe",
                "CommandLine": "runas /user:CORP\\svc_admin /SaveCred powershell.exe"}},
    {"name": "BENIGN: runas without /savecred (prompts for password)", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\runas.exe",
                "CommandLine": "runas /user:WIN-LAB\\labadmin cmd.exe"}},
    {"name": "BENIGN: runas help", "expect": false,
     "fields": {"Image": "C:\\Windows\\System32\\runas.exe",
                "CommandLine": "runas /?"}},
    {"name": "BENIGN: another program with '/savecred' in its arguments", "expect": false,
     "fields": {"Image": "C:\\Program Files\\Tool\\tool.exe",
                "CommandLine": "tool.exe /savecred-report out.txt"}}
  ]
}
